# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
# Signs session cookies. Use a different value per environment; production must
# set its own long random value (e.g. `openssl rand -hex 32`). Tests pass their own.
SESSION_SECRET=change-me
TOKEN_KEY=change-me

# Local Postgres (docker-compose.yml)
POSTGRES_USER=dbspy
POSTGRES_PASSWORD=dbspy_local
PG_HOST=localhost
PG_PORT=5432

# Local Redis (docker-compose.yml)
REDIS_URL=redis://localhost:6379
